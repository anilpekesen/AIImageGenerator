SHOPIFY_API_KEY="your_shopify_api_key"
SHOPIFY_API_SECRET="your_shopify_api_secret"
REPLICATE_API_TOKEN="your_replicate_api_token"
ANTHROPIC_API_KEY="your_anthropic_api_key"
GOOGLE_SEARCH_API_KEY="your_google_custom_search_api_key"
GOOGLE_SEARCH_ENGINE_ID="your_programmable_search_engine_id"
DATABASE_URL="file:./dev.db"
SCOPES="write_products,read_products,write_files,read_files"
SHOPIFY_APP_URL="https://your-app-domain.com"

# Use "single_merchant" while testing on a development/custom distribution app.
# Switch to "app_store" after the app is publicly distributed on Shopify App Store.
SHOPIFY_APP_DISTRIBUTION="single_merchant"
SHOPIFY_USE_TOKEN_EXCHANGE="false"
